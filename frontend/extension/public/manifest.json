{
  "manifest_version": 3,
  "name": "StudyLens",
  "version": "0.2.0",
  "description": "Send only text you explicitly select to your private local course tutor.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:5080/*"],
  "action": {
    "default_title": "Study selected text",
    "default_popup": "index.html"
  }
}

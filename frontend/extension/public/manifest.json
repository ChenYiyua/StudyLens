{
  "manifest_version": 3,
  "name": "StudyLens",
  "version": "0.2.0",
  "description": "Send only text you explicitly select to your private local course tutor.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:5080/*"],
  "action": {
    "default_title": "Study selected text",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "index.html"
  }
}

{
  "CourseCatalog": {
    "DefaultCourseId": "studylens-demo",
    "Courses": [
      {
        "Id": "studylens-demo",
        "IndexPath": "../../samples/demo-course-index.json",
        "SourceRoot": "../../samples/demo-course"
      }
    ],
    "ImportedCoursesRoot": "App_Data/imported-courses"
  },
  "CourseImport": {
    "ImportedCoursesRoot": "App_Data/imported-courses",
    "TimeoutSeconds": 300,
    "MaximumFileCount": 100,
    "MaximumFileBytes": 52428800,
    "MaximumCourseBytes": 262144000
  },
  "TutorAi": {
    "DefaultProfileId": "ollama-local",
    "Endpoint": "http://127.0.0.1:11434",
    "Model": "qwen3.5:4b",
    "TimeoutSeconds": 300,
    "ContextLength": 4096,
    "Profiles": [
      {
        "Id": "ollama-local",
        "DisplayName": "Qwen local",
        "Provider": "Ollama",
        "Endpoint": "http://127.0.0.1:11434",
        "Model": "qwen3.5:4b",
        "TimeoutSeconds": 300,
        "ContextLength": 4096
      },
      {
        "Id": "openai-gpt-5.4-mini",
        "DisplayName": "GPT-5.4 mini",
        "Provider": "OpenAI",
        "Endpoint": "https://api.openai.com/v1",
        "Model": "gpt-5.4-mini",
        "ApiKeyEnvironmentVariable": "OPENAI_API_KEY",
        "TimeoutSeconds": 180
      },
      {
        "Id": "openai-gpt-5.4-nano",
        "DisplayName": "GPT-5.4 nano",
        "Provider": "OpenAI",
        "Endpoint": "https://api.openai.com/v1",
        "Model": "gpt-5.4-nano",
        "ApiKeyEnvironmentVariable": "OPENAI_API_KEY",
        "TimeoutSeconds": 180
      },
      {
        "Id": "gemini-3.6-flash",
        "DisplayName": "Gemini 3.6 Flash · free tier",
        "Provider": "Gemini",
        "Endpoint": "https://generativelanguage.googleapis.com/v1beta",
        "Model": "gemini-3.6-flash",
        "ApiKeyEnvironmentVariable": "GEMINI_API_KEY",
        "TimeoutSeconds": 180
      }
    ]
  },
  "StudyData": {
    "Provider": "MongoDb",
    "LocalFilePath": "App_Data/study-attempts.json",
    "RetentionLimit": 5000
  },
  "MongoDb": {
    "ConnectionString": "mongodb://127.0.0.1:27017",
    "DatabaseName": "studylens",
    "CollectionName": "study_attempts"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
